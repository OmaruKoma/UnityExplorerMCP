{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "unity": {
      "type": "local",
      "command": [
        "node",
        "<REPO_PATH>/mcp-server/dist/server.js"
      ],
      "enabled": true,
      "environment": {
        "UNITY_BRIDGE_TIMEOUT": "120000",
        "UNITY_GAME_ROOT": "<GAME_ROOT_WITH_BEPINEX>"
      }
    }
  }
}
